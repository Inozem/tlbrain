{
  "schema_version": 1,
  "providers": [
    {
      "import_prefixes": [
        "google.auth",
        "google_auth_httplib2",
        "googleapiclient",
        "google.cloud.firestore"
      ],
      "requirements_files": [
        "core/google_drive/requirements.txt"
      ]
    },
    {
      "import_prefixes": [
        "google.genai"
      ],
      "requirements_files": [
        "core/gemini/requirements.txt"
      ]
    },
    {
      "import_prefixes": [
        "qdrant_client"
      ],
      "requirements_files": [
        "core/qdrant/requirements.txt"
      ]
    },
    {
      "import_prefixes": [
        "google.api_core",
        "google.cloud.tasks_v2"
      ],
      "requirements_files": [
        "core/utils/requirements.txt"
      ]
    }
  ],
  "optional_imports": [
    {
      "source_file": "core/utils/retry.py",
      "import_prefix": "googleapiclient.errors",
      "guard": "ImportError",
      "rationale": "Google API error formatting is optional when the client package is unavailable."
    },
    {
      "source_file": "core/utils/retry.py",
      "import_prefix": "qdrant_client.http.exceptions",
      "guard": "ImportError",
      "rationale": "Qdrant error handling is optional when the client package is unavailable."
    },
    {
      "source_file": "core/utils/retry.py",
      "import_prefix": "google.genai.errors",
      "guard": "ImportError",
      "rationale": "Gemini error formatting is optional when the client package is unavailable."
    },
    {
      "source_file": "core/utils/retry.py",
      "import_prefix": "requests.exceptions",
      "guard": "ImportError",
      "rationale": "HTTP error formatting is optional when requests is unavailable."
    }
  ]
}
