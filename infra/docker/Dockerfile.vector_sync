FROM python:3.12-slim AS builder

WORKDIR /src

COPY . /src

RUN python infra/build/assemble.py --service vector_sync --source-root /src --output /src/.build/vector_sync

FROM python:3.12-slim

WORKDIR /app

COPY --from=builder /src/.build/vector_sync/ /app/

RUN pip install --no-cache-dir -r /app/requirements.txt

RUN python -c "from fastembed import SparseTextEmbedding; SparseTextEmbedding(model_name='Qdrant/bm25')"

ENV PYTHONUNBUFFERED=1
ENV PORT=8080

CMD ["python", "-m", "uvicorn", "services.vector_sync.app.main:app", "--host", "0.0.0.0", "--port", "8080"]
