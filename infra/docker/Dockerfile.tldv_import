FROM python:3.12-slim AS builder

WORKDIR /src

COPY . /src

RUN python infra/build/assemble.py --service tldv_import --source-root /src --output /src/.build/tldv_import

FROM python:3.12-slim

WORKDIR /app

COPY --from=builder /src/.build/tldv_import/ /app/

RUN pip install --no-cache-dir -r /app/requirements.txt

ENV PYTHONUNBUFFERED=1
ENV PORT=8080

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
